{
  "lineWidth": 100,
  "indentWidth": 2,
  "useTabs": false,
  "plugins": [
    "https://plugins.dprint.dev/json-0.20.0.wasm",
    "https://plugins.dprint.dev/markdown-0.19.0.wasm",
    "https://plugins.dprint.dev/toml-0.7.0.wasm",
    "https://plugins.dprint.dev/yaml-0.10.0.wasm"
  ],
  "includes": ["**/*.{json,jsonc,md,toml,yml,yaml}"],
  "excludes": ["**/.git", "**/build", "**/build-*", "**/target", "**/dist"]
}
