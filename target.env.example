# Copy to target.env and replace only values verified on the target machine.
export BLOK_MODEL_ROOT=/mnt/kimi-model
export BLOK_META_ROOT="$HOME/.blok/metadata"
export BLOK_UGDS_DEVICE=/dev/ugds_drv0
export BLOK_UGDS_MAP="$PWD/ugds-map.blok"
export BLOK_UGDS_ENV_OUTPUT="$PWD/ugds.env"
export BLOK_KV_UGDS_BASE=REPLACE_WITH_RESERVED_RAW_BYTE_OFFSET
# 100 GiB; enough for exactly 10,000 input + 10,000 output tokens.
export BLOK_KV_UGDS_BYTES=107374182400
export BLOK_UGDS_PHYSICAL_OFFSET_ADD=0
